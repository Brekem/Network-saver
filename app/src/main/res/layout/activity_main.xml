<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- INDICADOR PRINCIPAL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/indicatorCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/indicatorTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="@color/status_on_container"
                        android:textStyle="bold"
                        tools:text="@string/indicator_active" />

                    <TextView
                        android:id="@+id/indicatorSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/status_on_container"
                        tools:text="@string/indicator_active_sub" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/deviceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Samsung SM-S911B · Android 14 (API 34) · One UI" />

            <!-- BOTONES PRINCIPALES -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActivate"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_activate"
                android:textSize="16sp"
                app:cornerRadius="32dp"
                app:icon="@android:drawable/ic_lock_power_off" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestore"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_restore"
                app:cornerRadius="28dp" />

            <!-- CONEXIÓN COMPARTIDA -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_connection" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/usbState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="@string/usb_connected" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUsbTethering"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_usb_tethering" />

                    <TextView
                        android:id="@+id/hotspotTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="Zona WiFi activa" />

                    <TextView
                        android:id="@+id/hotspotDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Activa · interfaz swlan0 · IP 192.168.43.1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHotspot"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_hotspot" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PANEL DE ESTADO -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_status" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/statusContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- APLICACIONES -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_apps" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/selectedApps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        tools:text="3 apps seleccionadas" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectApps"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_select_apps" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackgroundManager"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_background_manager" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DEVICE OWNER -->
            <TextView
                style="@style/SectionTitle"
                android:text="@string/section_device_owner" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/permissionLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="@string/level_standard" />

                    <TextView
                        android:id="@+id/deviceOwnerHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/device_owner_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textIsSelectable="true" />

                    <LinearLayout
                        android:id="@+id/deviceOwnerOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swKiosk"
                            style="@style/OwnerSwitch"
                            android:text="@string/do_kiosk" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swSuspend"
                            style="@style/OwnerSwitch"
                            android:text="@string/do_suspend" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swHide"
                            style="@style/OwnerSwitch"
                            android:text="@string/do_hide" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swBlockSettings"
                            style="@style/OwnerSwitch"
                            android:text="@string/do_block_settings" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swBlockInstall"
                            style="@style/OwnerSwitch"
                            android:text="@string/do_block_install" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swPower"
                            style="@style/OwnerSwitch"
                            android:text="@string/do_power" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/do_options_hint"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRemoveOwner"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/btn_remove_owner"
                            android:textColor="?attr/colorError" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- REGISTRO -->
            <TextView
                android:id="@+id/logTitle"
                style="@style/SectionTitle"
                android:text="@string/section_log"
                android:visibility="gone" />

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="✓ No Molestar activado\n✓ Brillo 10%" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
